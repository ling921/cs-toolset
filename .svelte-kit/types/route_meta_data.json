	"/": [
		"src/routes/+layout.ts",
		"src/routes/+layout.ts"
	],
	"/[locale]": [
		"src/routes/[locale]/+page.ts",
		"src/routes/[locale]/+layout.ts",
		"src/routes/+layout.ts",
		"src/routes/[locale]/+layout.ts",
		"src/routes/+layout.ts"
	],
	"/[locale]/[...slug]": [
		"src/routes/[locale]/[...slug]/+page.ts",
		"src/routes/[locale]/+layout.ts",
		"src/routes/+layout.ts"
	]
}