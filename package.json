{
  "name": "cs-toolset",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:build": "node scripts/verify-build.mjs",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@lucide/svelte": "^1.47.0",
    "@noble/hashes": "^2.0.0",
    "croner": "^9.1.0",
    "diff": "^8.0.0",
    "highlight.js": "11.11.1",
    "html-entities": "^2.6.0",
    "nanoid": "^5.1.0",
    "qrcode": "^1.5.4",
    "ulid": "^3.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "cheerio": "^1.1.2",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.12.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
